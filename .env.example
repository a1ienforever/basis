APP_NAME=basis
DEBUG=false

HTTP_PORT=8000

# Статический ключ для заголовка X-API-Key. Сгенерировать:
# или: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_API_KEY=change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basis

RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_MANAGEMENT_PORT=15672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/
RABBIT_EXCHANGE=payments
RABBIT_QUEUE=payments.new
RABBIT_DLQ=payments.dlq

OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_PUBLISH_TIMEOUT=5.0

CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_DELAY=1.0
CONSUMER_WEBHOOK_TIMEOUT=5.0

GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.9

LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
LOG_DATEFMT="%Y-%m-%d %H:%M:%S"
